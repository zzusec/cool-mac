<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">
    <title>清凉风扇</title>
    <welcome file="Welcome.html" mime-type="text/html"/>
    <conclusion file="Conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true" hostArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="14.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline><line choice="default"/></choices-outline>
    <choice id="default" visible="false" title="清凉风扇与后台组件">
        <pkg-ref id="local.hx10.coolmac.pkg"/>
    </choice>
    <pkg-ref id="local.hx10.coolmac.pkg" version="1.1.14" onConclusion="none">CoolMacComponent.pkg</pkg-ref>
</installer-gui-script>
